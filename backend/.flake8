[flake8]
max-line-length = 120
exclude = venv,__pycache__,*.pyc,tests/,database/setup_db.py
# Ignore style rules that don't affect functionality
ignore =
    E302,  # expected 2 blank lines
    E303,  # too many blank lines
    E305,  # expected 2 blank lines after function
    E402,  # module level import not at top
    E203,  # whitespace before ':'
    W291,  # trailing whitespace
    W293,  # blank line contains whitespace
    E128,  # continuation line under-indented
    E265,  # block comment format
    E114,  # indentation comment
    E116,  # unexpected indentation comment
    F811,  # redefinition of unused name
# Only fail on things that actually break code
per-file-ignores =
    backend/app.py:F401
    backend/model.py:F401
    backend/cloudinary_config.py:E251
    backend/database/db_config.py:E225,E302
    backend/generate_firebase_config.py:E302